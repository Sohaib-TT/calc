import { Button, VerticalBox, GridBox } from "std-widgets.slint";

component CalcButton inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <brush> bg-color: #1E2026;
    callback clicked();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 30px;
    min-height: 30px;
    max-height: 55px;

    background: touch-area.pressed ? #10B981 : root.bg-color;
    border-radius: 8px;

    Image {
        source: root.icon;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SciButton inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <brush> bg-color: #1E2026;
    callback clicked();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 27px;
    min-height: 20px;
    max-height: 25px;

    background: touch-area.pressed ? #10B981 : root.bg-color;
    border-radius: 18px;

    Image {
        source: root.icon;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {

