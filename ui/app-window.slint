import { Button, VerticalBox, GridBox, ScrollView, TextEdit } from "std-widgets.slint";

component CalcButton inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <brush> bg-color: #1E2026;
    callback clicked();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 30px;
    min-height: 30px;
    max-height: 55px;

    background: touch-area.pressed ? #10B981 : root.bg-color;
    border-radius: 8px;

    Image {
        source: root.icon;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SciButton inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <brush> bg-color: #1E2026;
    callback clicked();

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 27px;
    max-width: 100px;
    min-height: 20px;
    max-height: 25px;

    background: touch-area.pressed ? #10B981 : root.bg-color;
    border-radius: 18px;

    Image {
        source: root.icon;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }

    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}


export component AppWindow inherits Window {

    in property <[string]> display-list;
    in-out property <bool> leftOverflow : false;
    in-out property <bool> rightOverflow : false;

    callback open-docs();
    callback open-info();
    MenuBar {
        
        
        Menu {
            title: @tr("About");
            MenuItem {
                title: @tr("documntation");
                activated => {root.open-docs();}
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("info");
                activated => {root.open-info();}
            }
        }
    }
    
    preferred-height: 520px;
    preferred-width: 350px;
    min-height: 520px;
    min-width: 250px;
    background: #0a0a0a;

    callback button-pressed(string);
    callback container-resized(length);

    FocusScope {
        KeyBinding {keys: @keys(Digit0);activated => {root.button-pressed("0");}}
        KeyBinding {keys: @keys(Digit1);activated => {root.button-pressed("1");}}
        KeyBinding {keys: @keys(Digit2);activated => {root.button-pressed("2");}}
        KeyBinding {keys: @keys(Digit3);activated => {root.button-pressed("3");}}
        KeyBinding {keys: @keys(Digit4);activated => {root.button-pressed("4");}}
        KeyBinding {keys: @keys(Digit5);activated => {root.button-pressed("5");}}
        KeyBinding {keys: @keys(Digit6);activated => {root.button-pressed("6");}}
        KeyBinding {keys: @keys(Digit7);activated => {root.button-pressed("7");}}
        KeyBinding {keys: @keys(Digit8);activated => {root.button-pressed("8");}}
        KeyBinding {keys: @keys(Digit9);activated => {root.button-pressed("9");}}
        KeyBinding {keys: @keys(Plus);activated => {root.button-pressed("+");}}
        KeyBinding {keys: @keys(HyphenMinus);activated => {root.button-pressed("-");}}
        KeyBinding {keys: @keys(Asterisk);activated => {root.button-pressed("*");}}
        KeyBinding {keys: @keys(Slash);activated => {root.button-pressed("/");}}
        KeyBinding {keys: @keys(Period);activated => {root.button-pressed(".");}}
        KeyBinding {keys: @keys(Percent);activated => {root.button-pressed("%");}}
        KeyBinding {keys: @keys(OpenParen);activated => {root.button-pressed("(");}}
        KeyBinding {keys: @keys(CloseParen);activated => {root.button-pressed(")");}}
        KeyBinding {keys: @keys(E);activated => {root.button-pressed("e");}}
        KeyBinding {keys: @keys(Circumflex);activated => {root.button-pressed("^");}}
        KeyBinding {keys: @keys(Return);activated => {root.button-pressed("=");}}
        KeyBinding {keys: @keys(Backspace);activated => {root.button-pressed("del");}}
        KeyBinding {keys: @keys(Shift + Backspace);activated => {root.button-pressed("ac");}}
        KeyBinding {keys: @keys(RightArrow);activated => {root.button-pressed(">");}}
        KeyBinding {keys: @keys(LeftArrow);activated => {root.button-pressed("<");}}
    }
    VerticalLayout {
        GridLayout {
            Rectangle {
                min-height: 100px;
                background: #121316;
                border-bottom-left-radius: 20px;
                border-bottom-right-radius: 20px;
                changed width => {
                    root.container-resized(self.width);
                }
                ScrollView {
                vertical-scrollbar-policy: always-off; 
                horizontal-scrollbar-policy: as-needed;
                HorizontalLayout {
                    padding-top: 20px;
                    padding-left:5px;
                    Rectangle {
                        width: 24px;
                        if root.leftOverflow :Text {
                        text: "<";
                        color: white;
                        font-size: 26px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        }
                    }
                    for text-value[index] in display-list : Rectangle {
                        width: 15px;
                        if text-value == "I" : Rectangle{
                            width: 2px;
                            height: 27px;
                            background:#fefefe;
                        }
                        if text-value != "I" && text-value != "root" :Text {
                        text: text-value;
                        color: white;
                        font-size: 25px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        }
                    }
                    Rectangle {
                        width: 24px;
                        if root.rightOverflow :Text {
                        text: ">";
                        color: white;
                        font-size: 26px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        }
                    }
                    

                }
                }
            }
            vertical-stretch: 1;
        }
        GridLayout {
            padding-top: 7px;
            padding-right: 6px;
            padding-left: 6px;
            spacing: 3px;
            cross-axis-self-alignment: center;
            Row {
                SciButton {
                    icon: @image-url("../icons/pi.png");
                    bg-color: #434b5e;
                    value: "pi";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/pwr.png");
                    bg-color: #434b5e;
                    value: "^";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/(.png");
                    bg-color: #434b5e;
                    value: "(";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/).png");
                    bg-color: #434b5e;
                    value: ")";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/square root.png");
                    bg-color: #434b5e;
                    value: "root";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
            }
            Row {
                SciButton {
                    icon: @image-url("../icons/ln.png");
                    bg-color: #434b5e;
                    value: "ln(";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                SciButton {
                    icon: @image-url("../icons/log.png");
                    bg-color: #434b5e;
                    value: "log(";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                SciButton {
                    icon: @image-url("../icons/cos.png");
                    bg-color: #434b5e;
                    value: "cos(";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/sin.png");
                    bg-color: #434b5e;
                    value: "sin(";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
                SciButton {
                    icon: @image-url("../icons/tan.png");
                    bg-color: #434b5e;
                    value: "tan(";
                    clicked => {
                        root.button-pressed(self.value);
                    }}
            }
        }
        GridLayout {
            vertical-stretch: 3;
            height: 325px;

            spacing: 7px;
            padding: 10px;
            cross-axis-self-alignment: center;
            Row {
                CalcButton {
                    icon: @image-url("../icons/ac.png");
                    bg-color: #F43F5E;
                    value: "ac";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/ans.png");
                    bg-color: #F43F5E;
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/mod.png");
                    bg-color: #2D323F;
                    value: "%";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/div.png");
                    bg-color: #2D323F;
                    value: "/";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
            }

            Row {
                CalcButton {
                    icon: @image-url("../icons/7.png");
                    value: "7";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/8.png");
                    value: "8";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/9.png");
                    value: "9";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/mult.png");
                    bg-color: #2D323F;
                    value: "*";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
            }
            Row {
                CalcButton {
                    icon: @image-url("../icons/4.png");
                    value: "4";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/5.png");
                    value: "5";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/6.png");
                    value: "6";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/-.png");
                    bg-color: #2D323F;
                    value: "-";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
            }
            Row {
                CalcButton {
                    icon: @image-url("../icons/1.png");
                    value: "1";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/2.png");
                    value: "2";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/3.png");
                    value: "3";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/+.png");
                    bg-color: #2D323F;
                    value: "+";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
            }
            Row {
                CalcButton {
                    icon: @image-url("../icons/dot.png");
                    value: ".";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/0.png");
                    value: "0";
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/del.png");
                    value: "del";
                    bg-color: #2D323F;
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
                CalcButton {
                    icon: @image-url("../icons/=.png");
                    value: "=";
                    bg-color: #2D323F;
                    clicked => {
                        root.button-pressed(self.value);
                    }
                }
            }


        }
    }
    
}